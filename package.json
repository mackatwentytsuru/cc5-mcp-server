{
  "name": "cc5-mcp-server",
  "version": "1.1.0",
  "description": "MCP Server for Reallusion Character Creator 5 - AI-powered character creation via natural language",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "cc5-mcp-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
