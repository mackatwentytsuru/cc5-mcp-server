    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "mcp",
    "character-creator",
    "reallusion",
    "cc5",
    "ai",
    "3d-character"
  ],
  "license": "MIT"
}
